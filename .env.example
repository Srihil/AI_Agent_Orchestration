# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/orchestration
SYNC_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/orchestration

# LLM Provider
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# LLM_MODEL=anthropic/claude-3-haiku
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: for Ollama local dev
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Search Tool (optional - uses DuckDuckGo by default, no key required)
# SERPAPI_KEY=your_serpapi_key_here

# App Config
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Workflow Limits
MAX_WORKFLOW_STEPS=20
MAX_RETRIES=3
MAX_REVIEW_CYCLES=3

# Frontend (for Docker/Render)
VITE_API_URL=http://localhost:8000
